@base = http://localhost:8080

### 1. Create category
POST {{base}}/api/categories
Content-Type: application/json

{ "name": "Electronics" }

### 2. List categories
GET {{base}}/api/categories

### 3. Create product
POST {{base}}/api/products
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "description": "2.4GHz, USB receiver",
  "price": 599.00,
  "stockQty": 50,
  "categoryId": 1
}

### 4. List products
GET {{base}}/api/products

### 5. Get one product
GET {{base}}/api/products/1

### 6. Update product
PUT {{base}}/api/products/1
Content-Type: application/json

{
  "name": "Wireless Mouse Pro",
  "description": "Bluetooth + USB",
  "price": 799.00,
  "stockQty": 40,
  "categoryId": 1
}

### 7. Validation test (400 varanum)
POST {{base}}/api/products
Content-Type: application/json

{ "name": "", "price": -5, "stockQty": -1 }

### 8. Not found test (404 varanum)
GET {{base}}/api/products/999

### 9. Duplicate test (409 varanum, request 1 thirumba run pannunga)
POST {{base}}/api/categories
Content-Type: application/json

{ "name": "Electronics" }

### 10. Delete product
DELETE {{base}}/api/products/1

### 11. Page 1, 5 items, price high to low
GET {{base}}/api/products?page=0&size=5&sort=price,desc

### 12. Last page
GET {{base}}/api/products?page=4&size=5&sort=id,asc

### 13. Keyword search
GET {{base}}/api/products?keyword=mouse

### 14. Category + price range
GET {{base}}/api/products?categoryId=2&minPrice=300&maxPrice=600&sort=price,asc

### 15. Invalid sort field (400 varanum)
GET {{base}}/api/products?sort=abc

### 16. Register user (201, response la password varaadhu)
POST {{base}}/api/users
Content-Type: application/json

{ "name": "Test User", "email": "test@example.com", "password": "Pass@1234" }

### 17. Duplicate email (409)
POST {{base}}/api/users
Content-Type: application/json

{ "name": "Test User", "email": "TEST@example.com", "password": "Pass@1234" }

### 18. Register validation (400)
POST {{base}}/api/users
Content-Type: application/json

{ "name": "", "email": "abc", "password": "123" }

### 19. Add product 1, qty 2
POST {{base}}/api/users/1/cart/items
Content-Type: application/json

{ "productId": 1, "quantity": 2 }

### 20. Add product 1 again, qty 1 (same line la qty 3 aaganum)
POST {{base}}/api/users/1/cart/items
Content-Type: application/json

{ "productId": 1, "quantity": 1 }

### 21. Add product 2, qty 1
POST {{base}}/api/users/1/cart/items
Content-Type: application/json

{ "productId": 2, "quantity": 1 }

### 22. View cart
GET {{base}}/api/users/1/cart

### 23. Update item 1 quantity to 5
PUT {{base}}/api/users/1/cart/items/1
Content-Type: application/json

{ "quantity": 5 }

### 24. Stock exceed (400)
POST {{base}}/api/users/1/cart/items
Content-Type: application/json

{ "productId": 1, "quantity": 1000 }

### 25. Remove item 2
DELETE {{base}}/api/users/1/cart/items/2

### 26. Clear cart (204)
DELETE {{base}}/api/users/1/cart

### 27. Cart for unknown user (404)
GET {{base}}/api/users/999/cart

